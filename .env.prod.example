# Render prod (ветка main) — шаблон. Скопируй: cp .env.prod.example .env.prod
# Заполни секретами из Render Dashboard. .env.prod не коммитить.
# Canon: internal/config/config.go

APP_ENV=production
PORT=8080

DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/mentorix?sslmode=require
REDIS_URL=redis://default:PASSWORD@HOST:6379/0
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32

CORS_ALLOW_ORIGINS=https://app.mentorix.example.com
TRUSTED_PROXY_CIDRS=private

ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=30

REFRESH_COOKIE_NAME=mentorix_refresh
REFRESH_COOKIE_PATH=/auth
REFRESH_COOKIE_DOMAIN=.mentorix.example.com
REFRESH_COOKIE_SAMESITE=none
REFRESH_COOKIE_SECURE=true

AUTH_LOGIN_RATE_MAX=20
AUTH_LOGIN_RATE_WINDOW_SEC=900
AUTH_REGISTER_RATE_MAX=10
AUTH_REGISTER_RATE_WINDOW_SEC=900

TELEGRAM_BOT_USERNAME=mentorix_bot
TRAINER_INVITE_TTL_DAYS=7
BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN
BOT_WEBHOOK_URL=https://mentorix-backend.onrender.com/telegram/webhook
BOT_WEBHOOK_SECRET=REPLACE_WITH_openssl_rand_hex_32
