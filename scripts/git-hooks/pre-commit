#!/usr/bin/env bash
# Installed by: make install-hooks
# Runs fast checks before each commit (make check-quick): gofmt, vet, unit, lint.
# Integration, coverage, sqlc drift and docs-check run in CI (make check-ci).
#
# Skip once: git commit --no-verify
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

echo "=== pre-commit: make check-quick ==="
make check-quick
