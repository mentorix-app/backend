#!/usr/bin/env bash
# Installed by: make install-hooks
# Runs CI-parity checks before each commit (make check-ci).
#
# Override: PRE_COMMIT_CHECK_FLAGS='--no-coverage' git commit …
# Full local suite (migrate-check + smoke): make check
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

echo "=== pre-commit: make check-ci ==="
# shellcheck disable=SC2086
make check-ci CHECK_FLAGS="${PRE_COMMIT_CHECK_FLAGS:-}"
