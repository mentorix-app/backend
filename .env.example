# Template for .env — local development settings, git-ignored.
#   make setup   (copies this file to .env if it does not exist yet)
# Precedence: shell environment > .env. Canon of keys: internal/config/config.go.
# Render stage reads nothing from files: links come from render.yaml, secrets from the
# Dashboard (`sync: false`). Stage datastore URLs for local tooling live in .env.stage
# (see docs/environments.md).

APP_ENV=development
PORT=8080

# Local Postgres (dev credentials app:app); mentorix_test is used by integration tests
DATABASE_URL=postgres://app:app@localhost:5432/mentorix?sslmode=disable
TEST_DATABASE_URL=postgres://app:app@localhost:5432/mentorix_test?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Local frontend origins
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000
TRUSTED_PROXY_CIDRS=
# Shared with the dashboard's server, at least 32 bytes (openssl rand -hex 32). With it the server can
# forward the browser address for auth rate limits. Empty = the forwarding headers are ignored.
BFF_SHARED_SECRET=

# Git commit reported by GET /health. Render sets it at runtime; leave empty locally (field omitted).
RENDER_GIT_COMMIT=

# Required. HS256 key, at least 32 bytes (openssl rand -hex 32). Also signs avatar and client-analytics links.
JWT_SECRET=

ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=30
REFRESH_COOKIE_NAME=mentorix_refresh
REFRESH_COOKIE_PATH=/auth
REFRESH_COOKIE_DOMAIN=
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_SECURE=false

AUTH_LOGIN_RATE_MAX=20
AUTH_LOGIN_RATE_WINDOW_SEC=900

TRAINER_INVITE_TTL_DAYS=7

# Google OAuth client ids accepted by POST /auth/google, comma separated. Empty = Google sign-in answers 503.
GOOGLE_CLIENT_IDS=

# Audiences accepted by POST /auth/apple, comma separated: the iOS bundle id and, for Android, the Services ID. Empty = Apple sign-in answers 503.
APPLE_CLIENT_IDS=

# Android package name that POST /auth/apple/callback sends the browser back to (Apple sign-in on Android), e.g. com.example.app. Empty = the callback answers 503.
APPLE_ANDROID_PACKAGE=

# Revokes the Sign in with Apple authorization when an app client deletes the account (DELETE /auth/me). All three or none; a partial set stops the start.
# APPLE_TEAM_ID and APPLE_KEY_ID: 10 characters, A-Z and 0-9. APPLE_PRIVATE_KEY: the text of the .p8 file (P-256), on one line with \n for the line breaks.
# Empty = an account with an Apple sign-in answers 503 when it is deleted. Never commit a real key.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Telegram bot. All empty = bot disabled locally (push and webhook off).
TELEGRAM_BOT_USERNAME=
BOT_TOKEN=
BOT_WEBHOOK_URL=
BOT_WEBHOOK_SECRET=

# Frontend page for client self-analytics (Telegram «Статистика» button). Empty = button hidden.
# Absolute http(s) URL without query/fragment, e.g. http://localhost:3000/stats
CLIENT_ANALYTICS_PAGE_URL=
