# Единый шаблон: local (активные значения) + Render (комментарии / Blueprint sync:false).
# cp .env.example .env
# Infra: render.yaml — stage (develop) + prod (main). Flow: docs/environments.md
# Canon: internal/config/config.go

APP_ENV=development
PORT=8080

# Local app DB. For integration tests use a separate DB, e.g.:
# TEST_DATABASE_URL=postgres://app:app@localhost:5432/mentorix_test?sslmode=disable
DATABASE_URL=postgres://app:app@localhost:5432/mentorix?sslmode=disable
# Render stage (Blueprint mentorix-db-stage, External URL from Dashboard):
# postgres://USER:PASSWORD@HOST:5432/mentorix?sslmode=require

REDIS_URL=redis://localhost:6379/0
# Render stage: fromService connectionString (mentorix-redis-stage)

JWT_SECRET=local-dev-only-change-me-32chars!!
# Render stage: sync:false in Blueprint (openssl rand -hex 32)

CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000
# Render stage: sync:false — e.g. https://mentorix-frontend-dev.onrender.com (front URL)

TRUSTED_PROXY_CIDRS=
# Render stage: private

ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=30

REFRESH_COOKIE_NAME=mentorix_refresh
REFRESH_COOKIE_PATH=/auth
REFRESH_COOKIE_DOMAIN=
REFRESH_COOKIE_SAMESITE=lax
# Render stage: none
REFRESH_COOKIE_SECURE=false
# Render stage: true

AUTH_LOGIN_RATE_MAX=20
AUTH_LOGIN_RATE_WINDOW_SEC=900
AUTH_REGISTER_RATE_MAX=10
AUTH_REGISTER_RATE_WINDOW_SEC=900

TELEGRAM_BOT_USERNAME=
# Render stage: sync:false (stage bot, без @)

TRAINER_INVITE_TTL_DAYS=7

BOT_TOKEN=
# Render stage: sync:false (@BotFather)
BOT_WEBHOOK_URL=
# Render stage: https://mentorix-api-stage.onrender.com/telegram/webhook
BOT_WEBHOOK_SECRET=
# Render stage: sync:false (openssl rand -hex 32)
