# Copy to .env for local use. Defaults match docker-compose.yml.

APP_ENV=development
PORT=8080

# localhost: API runs on the host, not inside a container.
DATABASE_URL=postgres://app:app@localhost:5432/mentorix?sslmode=disable

REDIS_URL=redis://localhost:6379/0

# HS256 signing key (min 32 chars). Use a long random string in real envs.
JWT_SECRET=local-dev-only-change-me-32chars!!
