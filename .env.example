# --- Local development (Docker Compose: docker compose up -d) ---
APP_ENV=development
PORT=8080
DATABASE_URL=postgres://app:app@localhost:5432/mentorix?sslmode=disable
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=local-dev-secret-at-least-32-characters-long
CORS_ALLOW_ORIGINS=http://localhost:3000
ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=30
REFRESH_COOKIE_NAME=mentorix_refresh
REFRESH_COOKIE_PATH=/auth
AUTH_LOGIN_RATE_MAX=20
AUTH_LOGIN_RATE_WINDOW_SEC=900
AUTH_REGISTER_RATE_MAX=10
AUTH_REGISTER_RATE_WINDOW_SEC=900
# TRUSTED_PROXY_CIDRS=private   # use behind Render/nginx; empty = direct client IP only

# --- Render / managed cloud (uncomment and replace placeholders) ---
# DATABASE_URL=postgres://db_user:db_password@db.example.com:5432/mentorix?sslmode=require
# REDIS_URL=redis://default:redis_password@redis.example.com:6379/0
# CORS_ALLOW_ORIGINS=https://app.example.com
# TRUSTED_PROXY_CIDRS=private
# REFRESH_COOKIE_DOMAIN=.example.com
# REFRESH_COOKIE_SAMESITE=none
# REFRESH_COOKIE_SECURE=true
