# Copy to .env for local use. Defaults match docker-compose.yml.

APP_ENV=development
PORT=8080

# localhost: API runs on the host, not inside a container.
DATABASE_URL=postgres://app:app@localhost:5432/mentorix?sslmode=disable

REDIS_URL=redis://localhost:6379/0

# HS256 signing key (min 32 chars). Use a long random string in real envs.
JWT_SECRET=local-dev-only-change-me-32chars!!

# Browser origins allowed to call the API (comma-separated). Needed for SPA / cross-origin.
# On Render, set this to your deployed frontend origin (scheme + host + port if any).
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# Access JWT TTL (minutes). Refresh is an HttpOnly cookie; opaque token hash stored in DB.
ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=30

# Refresh cookie (cross-site SPA needs SameSite=None + Secure on HTTPS).
# REFRESH_COOKIE_SAMESITE=lax|strict|none — omit for auto: production=none, development=lax
# REFRESH_COOKIE_SECURE=true|false — omit for auto: production=true, development=false
REFRESH_COOKIE_NAME=mentorix_refresh
REFRESH_COOKIE_PATH=/auth

# Redis rate limits (per IP). Set max to 0 to disable that limiter. Requires REDIS_URL.
AUTH_LOGIN_RATE_MAX=20
AUTH_LOGIN_RATE_WINDOW_SEC=900
AUTH_REGISTER_RATE_MAX=10
AUTH_REGISTER_RATE_WINDOW_SEC=900
