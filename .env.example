APP_ENV=development
PORT=8080
DATABASE_URL=postgres://db_user:db_password@db.example.com:5432/mentorix?sslmode=require
REDIS_URL=redis://default:redis_password@redis.example.com:6379/0
JWT_SECRET=replace-with-a-random-string-at-least-32-chars
CORS_ALLOW_ORIGINS=https://app.example.com,http://localhost:3000
ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=30
REFRESH_COOKIE_NAME=mentorix_refresh
REFRESH_COOKIE_PATH=/auth
# REFRESH_COOKIE_DOMAIN=.example.com
# REFRESH_COOKIE_SAMESITE=none
# REFRESH_COOKIE_SECURE=true
AUTH_LOGIN_RATE_MAX=20
AUTH_LOGIN_RATE_WINDOW_SEC=900
AUTH_REGISTER_RATE_MAX=10
AUTH_REGISTER_RATE_WINDOW_SEC=900
