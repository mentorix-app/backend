            "method": "GET",
            "header": [],
            "url": "{{base_url}}/health/ready",
            "description": "Source: `internal/health/ready.go`\n\n200: `{status, checks}` — database/redis ok\n503: dependency недоступна"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /auth/register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const b = pm.response.json();",
                  "    pm.environment.set('access_token', b.access_token);",
                  "    pm.environment.set('user_id', b.user_id);",
                  "}",
                  "pm.test('status is 201 or 409', function () {",
                  "    pm.expect([201, 409]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\"\n}"
            },
            "url": "{{base_url}}/auth/register",
            "description": "Source: `internal/auth/handlers.go` → Register\n\nBody: email, password (min 8 chars)\n201: access_token, token_type, expires_at, user_id, email + Set-Cookie mentorix_refresh\n400: invalid email/password\n409: email already registered\n429: rate limit"
          },
          "response": []
        },
        {
          "name": "POST /auth/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "    const b = pm.response.json();",
                  "    pm.environment.set('access_token', b.access_token);",
                  "    pm.environment.set('user_id', b.user_id);",
                  "    pm.test('access_token saved', () => {",
                  "        pm.expect(pm.environment.get('access_token')).to.be.a('string').and.not.empty;",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\"\n}"
            },
            "url": "{{base_url}}/auth/login",
            "description": "Source: `internal/auth/handlers.go` → Login\n\n200: access_token + Set-Cookie mentorix_refresh\n401: invalid email or password"
          },
          "response": []
        },
        {
          "name": "POST /auth/refresh",
          "event": [
