          "name": "POST /auth/register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const b = pm.response.json();",
                  "    pm.environment.set('access_token', b.access_token);",
                  "    pm.environment.set('user_id', b.user_id);",
                  "}",
                  "pm.test('status is 201 or 409', function () {",
                  "    pm.expect([201, 409]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\"\n}"
            },
            "url": "{{base_url}}/auth/register",
            "description": "Source: `internal/auth/handlers.go` → Register\n\nBody: email, password (min 8 chars)\n201: access_token, token_type, expires_at, user_id, email + Set-Cookie mentorix_refresh\n400: invalid email/password\n409: email already registered\n429: rate limit"
