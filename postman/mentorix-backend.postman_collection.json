              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.environment.set('access_token', pm.response.json().access_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "url": "{{base_url}}/auth/refresh",
            "description": "Source: `internal/auth/handlers.go` → Refresh\n\nCookie: mentorix_refresh (HttpOnly, path /auth)\n200: новый access_token\n401: missing/invalid refresh token"
          },
          "response": []
        },
        {
          "name": "GET /auth/me",
          "event": [
